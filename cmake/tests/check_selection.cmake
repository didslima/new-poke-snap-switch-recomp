# ctest source_selection: checks cmake/sources.cmake against a fixture tree and against the real manifest.
#   cmake -DSNAP_TEST_ROOT=<repo> -P cmake/tests/check_selection.cmake
cmake_minimum_required(VERSION 3.20)
set(PROJECT_SOURCE_DIR "${SNAP_TEST_ROOT}")
include("${SNAP_TEST_ROOT}/cmake/sources.cmake")

function(expect_equal what actual expected)
  if(NOT "${actual}" STREQUAL "${expected}")
    message(FATAL_ERROR "${what}: expected [${expected}], got [${actual}]")
  endif()
endfunction()

# 1. fixture: lists and per-platform selection
set(fx "${SNAP_TEST_ROOT}/tests/platform/fixture")
snap_load_source_manifest("${fx}/manifest.txt" ROOT "${fx}" NO_TREE_CHECK)
expect_equal("shared" "${SNAP_SOURCES_SHARED}" "runtime/a.cpp;runtime/b.cpp")
expect_equal("windows" "${SNAP_SOURCES_WINDOWS}" "runtime/win.cpp")
expect_equal("linux" "${SNAP_SOURCES_LINUX}" "runtime/lin.cpp")
expect_equal("offline" "${SNAP_SOURCES_OFFLINE}" "host/tool.cpp")
snap_select_sources(windows w)
snap_select_sources(linux l)
expect_equal("windows selection" "${w}" "runtime/a.cpp;runtime/b.cpp;runtime/win.cpp")
expect_equal("linux selection" "${l}" "runtime/a.cpp;runtime/b.cpp;runtime/lin.cpp")
foreach(f ${l})
  if(f IN_LIST SNAP_SOURCES_WINDOWS OR f IN_LIST SNAP_SOURCES_OFFLINE)
    message(FATAL_ERROR "the Linux selection contains ${f}, which is not shared or linux")
  endif()
endforeach()

# 2. the real manifest loads, every entry exists, nothing in host/ or runtime/ is unclassified (this is the same check configure does)
snap_load_source_manifest("${SNAP_TEST_ROOT}/cmake/source_manifest.txt" ROOT "${SNAP_TEST_ROOT}")
snap_select_sources(linux real_linux)
foreach(f ${real_linux})
  if(f IN_LIST SNAP_SOURCES_WINDOWS)
    message(FATAL_ERROR "the Linux selection contains Windows-only ${f}")
  endif()
endforeach()
list(LENGTH SNAP_SOURCES_SHARED n_shared)
list(LENGTH SNAP_SOURCES_WINDOWS n_win)
if(n_shared EQUAL 0 OR n_win EQUAL 0)
  message(FATAL_ERROR "the real manifest has ${n_shared} shared and ${n_win} windows entries")
endif()

# 3. the loader refuses bad input (each case runs in a child cmake and must fail)
function(expect_failure name manifest needle)
  execute_process(
    COMMAND ${CMAKE_COMMAND} -DSNAP_TEST_ROOT=${SNAP_TEST_ROOT} -DSNAP_BAD_MANIFEST=${manifest}
            -P ${SNAP_TEST_ROOT}/cmake/tests/load_bad.cmake
    RESULT_VARIABLE rc ERROR_VARIABLE err OUTPUT_QUIET)
  if(rc EQUAL 0)
    message(FATAL_ERROR "${name}: the loader accepted it")
  endif()
  if(NOT err MATCHES "${needle}")
    message(FATAL_ERROR "${name}: failed for another reason: ${err}")
  endif()
endfunction()
expect_failure("unknown class" "${fx}/bad_class.txt" "unknown class 'cloud'")
expect_failure("duplicate" "${fx}/bad_duplicate.txt" "listed twice")
expect_failure("missing file" "${fx}/bad_missing.txt" "does not exist")
expect_failure("unclassified file" "${fx}/bad_unclassified.txt" "Unclassified source files")
message(STATUS "source_selection: OK")
