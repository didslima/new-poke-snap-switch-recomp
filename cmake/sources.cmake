# Source selection by platform (docs/linux-port.md).
#
# cmake/source_manifest.txt lists every C/C++ file of the game binary (host/, runtime/) with exactly one class:
# shared, windows, linux or offline. This file turns the manifest into lists and fails the configure step when the manifest and the
# tree disagree, so a new file can never join a build by accident (there is no glob of sources anywhere in the build).
#
#   snap_load_source_manifest(<manifest> [ROOT <dir>] [NO_TREE_CHECK])
#       sets SNAP_SOURCES_SHARED / _WINDOWS / _LINUX / _OFFLINE (paths relative to ROOT; default: the project directory)
#   snap_select_sources(<windows|linux> <out-var>)
#       <out-var> = shared + the platform's own sources
#
# The Windows game is still built by host/build_snap.py, which keeps its own selection; tests/recomp/test_source_classification.py
# checks that selection against the manifest. The Windows list here is for tooling and for the day the build moves to CMake.

set(_SNAP_CLASSES shared windows linux offline)
set(_SNAP_SCOPES host runtime)

function(snap_load_source_manifest manifest)
  cmake_parse_arguments(A "NO_TREE_CHECK" "ROOT" "" ${ARGN})
  if(NOT A_ROOT)
    set(A_ROOT "${PROJECT_SOURCE_DIR}")
  endif()
  foreach(c ${_SNAP_CLASSES})
    set(_list_${c} "")
  endforeach()
  set(_seen "")
  file(STRINGS "${manifest}" _lines)
  foreach(line IN LISTS _lines)
    string(REGEX REPLACE "#.*$" "" line "${line}")
    string(STRIP "${line}" line)
    if(line STREQUAL "")
      continue()
    endif()
    if(NOT line MATCHES "^([a-z]+)[ \t]+([^ \t]+)$")
      message(FATAL_ERROR "${manifest}: malformed line '${line}' (expected '<class> <path>')")
    endif()
    set(cls "${CMAKE_MATCH_1}")
    set(path "${CMAKE_MATCH_2}")
    if(NOT cls IN_LIST _SNAP_CLASSES)
      message(FATAL_ERROR "${manifest}: unknown class '${cls}' for ${path} (one of: ${_SNAP_CLASSES})")
    endif()
    if(path IN_LIST _seen)
      message(FATAL_ERROR "${manifest}: ${path} is listed twice")
    endif()
    if(NOT EXISTS "${A_ROOT}/${path}")
      message(FATAL_ERROR "${manifest}: ${path} does not exist (renamed or deleted? update the manifest)")
    endif()
    list(APPEND _seen "${path}")
    list(APPEND _list_${cls} "${path}")
  endforeach()

  if(NOT A_NO_TREE_CHECK)
    # Detection only: this glob never selects a source, it looks for files the manifest does not know about.
    set(_found "")
    set(_depends CONFIGURE_DEPENDS)   # re-run configure when a file appears; not valid in -P script mode (the tests)
    if(CMAKE_SCRIPT_MODE_FILE)
      set(_depends "")
    endif()
    foreach(scope ${_SNAP_SCOPES})
      file(GLOB_RECURSE _f RELATIVE "${A_ROOT}" ${_depends} "${A_ROOT}/${scope}/*.cpp" "${A_ROOT}/${scope}/*.c" "${A_ROOT}/${scope}/*.cc")
      list(APPEND _found ${_f})
    endforeach()
    set(_missing "")
    foreach(f IN LISTS _found)
      if(NOT f IN_LIST _seen)
        list(APPEND _missing "${f}")
      endif()
    endforeach()
    if(_missing)
      string(REPLACE ";" "\n  " _m "${_missing}")
      message(FATAL_ERROR "Unclassified source files (add each to ${manifest}; run `python3 -I scripts/source_classes.py` for a suggested class):\n  ${_m}")
    endif()
  endif()

  foreach(c ${_SNAP_CLASSES})
    string(TOUPPER "${c}" C)
    set(SNAP_SOURCES_${C} "${_list_${c}}" PARENT_SCOPE)
  endforeach()
endfunction()

function(snap_select_sources platform out)
  if(platform STREQUAL "windows")
    set(r ${SNAP_SOURCES_SHARED} ${SNAP_SOURCES_WINDOWS})
  elseif(platform STREQUAL "linux")
    set(r ${SNAP_SOURCES_SHARED} ${SNAP_SOURCES_LINUX})
  else()
    message(FATAL_ERROR "snap_select_sources: unknown platform '${platform}' (windows or linux)")
  endif()
  set(${out} "${r}" PARENT_SCOPE)
endfunction()
